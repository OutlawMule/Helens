# ─────────────────────────────────────────────────────────────
# Helens Haven – environment variables
# Copy to .env.local for local work; add the same names in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used in emails and metadata). Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# URL and anon/publishable key are safe for the browser (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
# Used by API routes (public booking submission, availability, lookup) and the create-admin script.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (optional) ─────────────────────────────────────────
# Leave EMAIL_PROVIDER empty to run without email. The site will then say plainly that
# no email was sent. Supported value: resend
EMAIL_PROVIDER=
RESEND_API_KEY=
# A sender address on a domain you have verified with your provider
EMAIL_FROM=
# Optional: receive a notification email for each new booking request / contact message
ADMIN_NOTIFY_EMAIL=

# ── Build escape hatch (optional) ────────────────────────────
# Set to 1 to let a deployment succeed even if TypeScript reports errors. Leave empty normally.
SKIP_TYPECHECK=
